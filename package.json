    "drizzle-orm": "^0.44.0",
    "lucide-react": "^0.469.0",
    "nanoid": "^5.0.9",
    "next": "15.5.21",
    "openai": "^4.83.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.3",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
