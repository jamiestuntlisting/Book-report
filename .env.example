# ---- Supabase ----
# From your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- AI ----
# Claude (chapter rewriting, voice profile)
ANTHROPIC_API_KEY=sk-ant-...
# Transcription (default provider is OpenAI Whisper; swappable)
OPENAI_API_KEY=sk-...

# ---- App ----
# Public base URL, used for magic-link redirects and share links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared secret so the PDF renderer can load the private /book/print page.
PDF_RENDER_TOKEN=generate-a-long-random-string

# ---- Name verification (story review) ----
# Free API key from https://www.themoviedb.org/settings/api — verifies people's
# names/spelling and links to their IMDb pages. Review works without it (AI-only).
TMDB_API_KEY=

# ---- SMS (weekly reminder texts) ----
# From your Twilio console. Reminder texts are skipped when unset.
# NOTE: texted login codes are configured separately, in the Supabase dashboard
# (Authentication -> Providers -> Phone -> Twilio).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Cron ----
# Secret guarding /api/cron/reminders. Vercel Cron sends it automatically when
# this env var is set on the project.
CRON_SECRET=generate-another-long-random-string

# ---- Interviews / Zoom (optional; stubbed until configured) ----
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=
# Scheduling provider (optional)
CALCOM_API_KEY=
CALENDLY_TOKEN=
