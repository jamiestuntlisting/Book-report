# ---- Supabase ----
# From your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- AI ----
# Claude (chapter rewriting, voice profile)
ANTHROPIC_API_KEY=sk-ant-...
# Transcription (default provider is OpenAI Whisper; swappable)
OPENAI_API_KEY=sk-...

# ---- App ----
# Public base URL, used for magic-link redirects and share links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared secret so the PDF renderer can load the private /book/print page.
PDF_RENDER_TOKEN=generate-a-long-random-string

# ---- Interviews / Zoom (optional; stubbed until configured) ----
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=
# Scheduling provider (optional)
CALCOM_API_KEY=
CALENDLY_TOKEN=
